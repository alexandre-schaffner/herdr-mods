# Whitelist: only my own mods and layouts. Everything else here is Herdr's
# (shipped mods and layouts, state, caches, window bookkeeping).
/*
!/.gitignore
!/README.md
!/keys.json
!/shared/

!/mods/
/mods/*
!/mods/claude-picker/
!/mods/claude-reader/
!/mods/hq/
!/mods/master/
!/mods/my-new-menu/
!/mods/my-pane/
!/mods/my-spaces/
!/mods/my-spaces-group/
!/mods/my-tabs/
!/mods/proxy/
!/mods/workflows/

!/layouts/
/layouts/*
!/layouts/my-main.json

# Generated or local, inside the mods
gpui-kit.d.ts
__pycache__/
.cache/
*.error
.DS_Store
